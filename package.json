{
  "name": "protocol-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Protocol Atlas — an interactive visual guide to computer networking and communication protocols.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:worker": "node cloudflare/test-worker.mjs",
    "test:contract": "node cloudflare/test-contract.mjs",
    "test:config": "node cloudflare/validate-config.mjs",
    "test:root": "node cloudflare/check-root-nav.mjs",
    "test:diagnose": "node cloudflare/diagnose-prefix.mjs",
    "test:live": "node cloudflare/test-live-origin.mjs",
    "test:public": "node cloudflare/test-public-route.mjs",
    "test:local": "npm run test:worker && npm run test:contract && npm run test:config && npm run test:live",
    "test": "npm run test:local"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "next": "15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
